# Токен бота MAX: business.max.ru → Чат-боты → Настройки.
# Старое имя TELEGRAM_BOT_TOKEN больше не читается.
MAX_BOT_TOKEN=

# Отдельный бот для тестового запуска (src/digital_professor_testing).
# Если пусто, берётся MAX_BOT_TOKEN.
MAX_BOT_TOKEN_TEST=

# Чат MAX для ERROR-логов. Топиков в MAX нет.
ERROR_LOG_CHAT_ID=

# Необязательно. По умолчанию используется certs/russian_trusted_root_ca.pem
# MAX_ROOT_CA_PATH=

LOG_LEVEL=INFO

# Moodle
MOODLE_URL=https://elearn.urfu.ru
MOODLE_TOKEN=
COURSE_ID_1=8788

# OpenRouter
API_KEY=
